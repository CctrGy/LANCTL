:root[data-theme=light]{color-scheme:light;--bg:#f2f5f7;--panel:#fff;--input:#f6f8fa;--line:#cdd6dd;--text:#202c35;--muted:#586875;--accent:#b2ef26;--accent-text:#1b2609}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select{font:inherit;color:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:9px 16px}button:hover{border-color:#8ca85c}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.app{height:100vh;height:100dvh;display:flex;flex-direction:column;max-width:1100px;margin:auto}header{padding:25px 30px 21px;display:flex;gap:20px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-size:20px;font-weight:750;letter-spacing:2px}.brand span{color:var(--accent)}.brand small{display:block;color:var(--muted);font-size:10px;font-weight:500;letter-spacing:2px;margin-top:4px}.badge{color:var(--muted);font-size:11px;letter-spacing:.7px;padding:5px 10px;border:1px solid var(--line);border-radius:20px}main{padding:24px 30px 28px;overflow:auto;flex:1;min-height:0}h1{font-size:25px;margin:0;font-weight:650;letter-spacing:-.5px}.intro{color:var(--muted);margin:5px 0 22px}.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:24px}.tabs button{border:0;border-bottom:3px solid transparent;border-radius:8px 8px 0 0;background:transparent;color:var(--muted);padding:11px 20px}.tabs button[aria-selected=true]{color:var(--text);background:var(--panel);border-bottom-color:var(--accent)}[hidden]{display:none!important}.section-title{font-size:16px;margin:0 0 4px;font-weight:650}.section-description{color:var(--muted);font-size:12px;margin:0 0 20px}.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px;margin-bottom:16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 24px}.field{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:13px}.field>span{font-weight:550}.field small{color:var(--muted);font-size:11px}input:not([type=checkbox]),select{width:100%;min-width:0;background:var(--input);border:1px solid var(--line);border-radius:7px;padding:10px 12px}input[type=checkbox]{accent-color:var(--accent);width:17px;height:17px;flex:none;margin:2px 0 0}.check{display:flex;gap:12px;align-items:start;cursor:pointer;font-size:13px}.check strong{font-weight:550;display:block}.check small{display:block;color:var(--muted);font-size:12px;margin-top:3px}.check+.check{margin-top:19px}.suffix{position:relative}.suffix input{padding-right:70px}.suffix>span{position:absolute;right:13px;top:11px;color:var(--muted);font-size:12px}.folder{display:flex;gap:8px}.folder input{flex:1}.folder button{flex:none;padding:8px 12px}footer{border-top:1px solid var(--line);padding:17px 30px;display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--bg)}.actions{display:flex;gap:10px;flex-wrap:wrap}.primary{background:var(--accent);color:var(--accent-text);border-color:var(--accent);font-weight:650}.state{font-size:12px;color:var(--muted);margin:0;flex:1;min-width:140px}.state.changed{color:var(--text)}.quiet{background:transparent}dialog{background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:24px;width:min(440px,90vw)}dialog::backdrop{background:#0009}dialog h2{font-size:18px;margin:0 0 7px}dialog p{font-size:12px;color:var(--muted)}dialog button{display:block;width:100%;text-align:left;margin-top:10px}.preview-swatch{height:55px;border-radius:8px;margin-top:16px;background:var(--input);border:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:14px;font-size:12px}.dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
@media(max-width:650px){header{padding:18px}main{padding:20px 18px}.grid{grid-template-columns:1fr}.card{padding:18px}footer{padding:15px 18px}.tabs button{padding:10px 13px}.badge{font-size:10px}.actions{width:100%;justify-content:flex-end}}
