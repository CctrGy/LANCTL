gui/prototypes/settings-preview.html,56,9,SHARED,GUI:PROTOTYPE,html-text,REVIEW_EMBEDDED_CODE,html/body/script,,"
const form=document.querySelector('#settings'),status=document.querySelector('#state'),tabs=[...document.querySelectorAll('[role=tab]')],folderDialog=document.querySelector('#folders');
function selectTab(tab){for(const item of tabs){const active=item===tab;item.setAttribute('aria-selected',active);item.tabIndex=active?0:-1;document.getElementById(item.getAttribute('aria-controls')).hidden=!active;}}
for(const tab of tabs){tab.onclick=()=>selectTab(tab);tab.onkeydown=event=>{let index=tabs.indexOf(tab);if(event.key==='ArrowRight')index=(index+1)%tabs.length;else if(event.key==='ArrowLeft')index=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')index=0;else if(event.key==='End')index=tabs.length-1;else return;event.preventDefault();selectTab(tabs[index]);tabs[index].focus();};}
function changed(){status.textContent='Cambios de ejemplo sin guardar';status.classList.add('changed');}
form.addEventListener('input',changed);form.addEventListener('change',changed);
form.elements.theme.onchange=()=>{document.documentElement.dataset.theme=form.elements.theme.value;};
form.elements.density.onchange=()=>{document.querySelectorAll('.card').forEach(card=>card.style.padding=form.elements.density.value==='Compacta'?'14px':'');};
form.elements.tips.onchange=()=>document.querySelectorAll('.field small').forEach(item=>item.hidden=!form.elements.tips.checked);
form.onsubmit=event=>{event.preventDefault();status.textContent='Guardado simulado. No se ha escrito ningún archivo.';status.classList.remove('changed');};
document.querySelector('#reset').onclick=()=>{form.reset();delete document.documentElement.dataset.theme;document.querySelectorAll('.card').forEach(card=>card.style.padding='');document.querySelectorAll('.field small').forEach(item=>item.hidden=false);status.textContent='Valores de ejemplo restablecidos.';status.classList.remove('changed');};
document.querySelector('#browse').onclick=()=>folderDialog.showModal();
for(const button of document.querySelectorAll('[data-folder]'))button.onclick=()=>{form.elements.folder.value=button.dataset.folder;folderDialog.close();changed();};
document.querySelector('#cancel-folder').onclick=()=>folderDialog.close();
document.querySelector('#close').onclick=()=>{if(window.pywebview?.api.close_preview)window.pywebview.api.close_preview();else{status.textContent='Puedes cerrar esta pestaña del navegador.';}};
",3196c1e64b9d4e88973f28158a9a37563bc39c5eb9b9a8ce5060a41d9864a4a5
