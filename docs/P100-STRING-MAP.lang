        "P100.STRING.9CA4E277F73FA318718BBCCC": "f\"versión del coordinador no compatible: {version}\"",
        "P100.STRING.0AC7EC9BC9669F1471618EF7": "\n                CREATE TABLE IF NOT EXISTS sessions (\n                    id TEXT PRIMARY KEY, owner TEXT NOT NULL, pid INTEGER NOT NULL,\n                    launcher TEXT NOT NULL, mode TEXT NOT NULL, project TEXT,\n                    heartbeat REAL NOT NULL, started REAL NOT NULL, parent TEXT,\n                    controls INTEGER NOT NULL DEFAULT 0);\n                CREATE TABLE IF NOT EXISTS events (\n                    seq INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT NOT NULL,\n                    session TEXT NOT NULL, event TEXT NOT NULL, project TEXT,\n                    correlation TEXT NOT NULL, created REAL NOT NULL, metadata TEXT NOT NULL);\n                CREATE TABLE IF NOT EXISTS tasks (\n                    id TEXT PRIMARY KEY, session TEXT NOT NULL, owner TEXT NOT NULL,\n                    origin TEXT NOT NULL, state TEXT NOT NULL, started REAL NOT NULL,\n                    finished REAL);\n                CREATE TABLE IF NOT EXISTS commands (\n                    id TEXT PRIMARY KEY, target TEXT NOT NULL, owner TEXT NOT NULL,\n                    action TEXT NOT NULL, value TEXT, state TEXT NOT NULL,\n                    created REAL NOT NULL, finished REAL);\n            ",
        "P100.STRING.F317897D43A21192B098A913": "f\"PRAGMA user_version={SCHEMA_VERSION}\"",
        "P100.STRING.3E66EAF5DBC75CE56615E625": "INSERT INTO sessions VALUES (?,?,?,?,?,?,?,?,?,0)",
        "P100.STRING.0FC367E2636928CD7BEF8D14": "UPDATE sessions SET heartbeat=?, project=?, controls=? WHERE id=? AND owner=?",
        "P100.STRING.A974491712B69E2B3A306683": "DELETE FROM sessions WHERE id=? AND owner=?",
        "P100.STRING.D68EB7C2A359E54195E957C1": "UPDATE tasks SET state='interrupted',finished=? WHERE session=? AND state='running' AND owner=?",
        "P100.STRING.AA840235051E6A14B0364198": "UPDATE commands SET state='expired',finished=? WHERE target=? AND state='queued' AND owner=?",
        "P100.STRING.91BC84BCBE27AE085390ADAB": "DELETE FROM sessions WHERE heartbeat<?",
        "P100.STRING.0A7670F9B685C58984BFBE85": "UPDATE tasks SET state='interrupted',finished=? WHERE state='running' AND session NOT IN (SELECT id FROM sessions WHERE heartbeat>=?)",
        "P100.STRING.684F83D2CD6E160776B49164": "UPDATE commands SET state='expired',finished=? WHERE state='queued' AND (created<? OR target NOT IN (SELECT id FROM sessions WHERE heartbeat>=?))",
        "P100.STRING.37CE7F7502921D7D5C08F885": "DELETE FROM events WHERE seq <= (SELECT COALESCE(MAX(seq),0)-? FROM events)",
        "P100.STRING.DF981545EF0DC72A8A04F23D": "DELETE FROM tasks WHERE finished<?",
        "P100.STRING.7996CEF579D0BA7F0CB1CA9F": "DELETE FROM commands WHERE finished<?",
        "P100.STRING.57D072C569EA6E562B8E96E1": "SELECT * FROM sessions WHERE (? OR owner=?) AND heartbeat>=? ORDER BY started",
        "P100.STRING.C44F8A18FC90A56383A52F7A": "el ID de evento debe tener cuatro segmentos",
        "P100.STRING.41EFCC04F7A610FF314E1FF7": "version",
