        "P100.STRING.47D8B611C7B1126B64AA3FB1": "SELECT device_id,COUNT(*) samples,SUM(CASE WHEN presence=1 THEN 1 ELSE 0 END) online,AVG(latency_ms) latency,SUM(CASE WHEN presence=0 THEN 1 ELSE 0 END) outages FROM samples WHERE session_id=? AND check_type IN ('availability','ping','arp') GROUP BY device_id",
