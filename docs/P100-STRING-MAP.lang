        "P100.STRING.696E4C571E4E137BA66C1C91": "\nconst form=document.querySelector('#settings'),status=document.querySelector('#state'),tabs=[...document.querySelectorAll('[role=tab]')],folderDialog=document.querySelector('#folders');\nfunction selectTab(tab){for(const item of tabs){const active=item===tab;item.setAttribute('aria-selected',active);item.tabIndex=active?0:-1;document.getElementById(item.getAttribute('aria-controls')).hidden=!active;}}\nfor(const tab of tabs){tab.onclick=()=>selectTab(tab);tab.onkeydown=event=>{let index=tabs.indexOf(tab);if(event.key==='ArrowRight')index=(index+1)%tabs.length;else if(event.key==='ArrowLeft')index=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')index=0;else if(event.key==='End')index=tabs.length-1;else return;event.preventDefault();selectTab(tabs[index]);tabs[index].focus();};}\nfunction changed(){status.textContent='Cambios de ejemplo sin guardar';status.classList.add('changed');}\nform.addEventListener('input',changed);form.addEventListener('change',changed);\nform.elements.theme.onchange=()=>{document.documentElement.dataset.theme=form.elements.theme.value;};\nform.elements.density.onchange=()=>{document.querySelectorAll('.card').forEach(card=>card.style.padding=form.elements.density.value==='Compacta'?'14px':'');};\nform.elements.tips.onchange=()=>document.querySelectorAll('.field small').forEach(item=>item.hidden=!form.elements.tips.checked);\nform.onsubmit=event=>{event.preventDefault();status.textContent='Guardado simulado. No se ha escrito ningún archivo.';status.classList.remove('changed');};\ndocument.querySelector('#reset').onclick=()=>{form.reset();delete document.documentElement.dataset.theme;document.querySelectorAll('.card').forEach(card=>card.style.padding='');document.querySelectorAll('.field small').forEach(item=>item.hidden=false);status.textContent='Valores de ejemplo restablecidos.';status.classList.remove('changed');};\ndocument.querySelector('#browse').onclick=()=>folderDialog.showModal();\nfor(const button of document.querySelectorAll('[data-folder]'))button.onclick=()=>{form.elements.folder.value=button.dataset.folder;folderDialog.close();changed();};\ndocument.querySelector('#cancel-folder').onclick=()=>folderDialog.close();\ndocument.querySelector('#close').onclick=()=>{if(window.pywebview?.api.close_preview)window.pywebview.api.close_preview();else{status.textContent='Puedes cerrar esta pestaña del navegador.';}};\n"
      },
